{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://gmarkov634-stack.github.io/kirov-gmu-calendar/schemas/schedule-batch.schema.json","title":"Schedule Batch v1","type":"object","additionalProperties":false,"required":["schema_version","schedule","events"],"properties":{"schema_version":{"const":"1.0"},"schedule":{"type":"object","additionalProperties":false,"required":["university_code","academic_year","semester","faculty_code","course","group","period","source_files","generated_at","parser"],"properties":{"university_code":{"type":"string","pattern":"^[a-z0-9_-]+$"},"academic_year":{"type":"string","pattern":"^20\\d{2}/20\\d{2}$"},"semester":{"enum":["autumn","spring","summer","other"]},"faculty_code":{"type":["string","null"]},"course":{"type":["integer","null"],"minimum":1,"maximum":10},"group":{"type":"string","minLength":1},"period":{"type":"object","additionalProperties":false,"required":["start_date","end_date","week1_start_date"],"properties":{"start_date":{"type":"string","format":"date"},"end_date":{"type":"string","format":"date"},"week1_start_date":{"type":"string","format":"date"}}},"source_files":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"generated_at":{"type":["string","null"],"format":"date-time"},"parser":{"type":"string","minLength":1},"schedule_version_id":{"type":["string","null"],"pattern":"^ver_[A-Za-z0-9_-]+$"},"previous_schedule_version_id":{"type":["string","null"],"pattern":"^ver_[A-Za-z0-9_-]+$"},"content_fingerprint":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"version_created_at":{"type":["string","null"],"format":"date-time"}}},"events":{"type":"array","items":{"$ref":"schedule-event.schema.json"}}}}
